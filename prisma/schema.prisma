// Schéma du Pilote. PostgreSQL depuis le 17/09/2026 (SQLite jusque-là ; migrations SQLite dans l'historique git avant `41fd2af`)
// (aucun type propre au moteur ; les listes de valeurs sont des tables).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pole {
  id       String    @id @default(cuid())
  name     String
  leadId   String?
  lead     Person?   @relation("PoleLead", fields: [leadId], references: [id])
  members  Person[]  @relation("PoleMembers")
  projects Project[]
  secondaryOf ProjectPole[]
  requests Request[]
}

// Rôles et droits (lot F2) : un rôle porte un sous-ensemble du catalogue lib/permissions.ts (clés séparées par des virgules)
// et un niveau de validation. Les six rôles d'origine sont « système » (code fixe, non supprimables) ; on peut en créer d'autres.
model Role {
  code            String   @id
  label           String
  description     String   @default("")
  order           Int      @default(0)
  system          Boolean  @default(false)
  validationLevel Int      @default(0) // 0 n'approuve rien · 1 son édition · 2 son pôle · 3 partout
  permissions     String   @default("")
  people          Person[]
}

model Person {
  id            String   @id @default(cuid())
  name          String // « Prénom Nom », affiché partout ; tenu en cohérence avec firstName / lastName (lot E1)
  // Fiche (lot E1) : identité, poste, dates de présence. `leftAt` est posé par « Préparer un départ » ; rien n'est effacé.
  firstName     String   @default("")
  lastName      String   @default("")
  jobTitle      String? // fonction affichée : « chargée de mission ESS et emploi »
  phone         String?
  arrivedAt     DateTime?
  leftAt        DateTime?
  note          String?
  poleId        String?
  pole          Pole?    @relation("PoleMembers", fields: [poleId], references: [id])
  role          String // code d'un Role (pilot | contributor | pole_lead | director | raf | assistant | rôles créés dans l'admin)
  roleRef       Role     @relation(fields: [role], references: [code])
  workRhythm    String // option_a | option_b | part_time | apprentice
  availableDays Int      @default(200)
  active        Boolean  @default(true)
  order         Int      @default(0)
  icsToken      String?  @unique // jeton du flux agenda personnel (.ics)
  // Compte de connexion (lot F) : l'identité d'accès est le User (better-auth), l'identité métier reste la Person.
  // Une Person sans compte existe (contact, personne partie) ; un User sans Person ne peut rien faire.
  email         String?  @unique
  userId        String?  @unique
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Modules activés par la personne (Mon compte) : tasks | notes | split. Un module coupé disparaît de la navigation.
  modules       String   @default("tasks,notes,split")
  // Part fixe (lettre de mission FSE, art. 55 §5 du règlement 2021/1060) : aucune répartition hebdomadaire attendue.
  fixedShare     Boolean @default(false)
  fixedShareNote String?
  rhythmPeriods PersonRhythmPeriod[]
  weekDeclarations WeekDeclaration[]

  ledPoles           Pole[]              @relation("PoleLead")
  timeCodes          PersonTimeCode[]
  pilotedProjects    Project[]           @relation("ProjectPilot")
  guaranteedProjects Project[]           @relation("ProjectGuarantor")
  teams              EditionTeam[]
  personDays         EditionPersonDays[]
  actions            Action[]
  timeEntries        TimeEntry[]
  monthLocks         MonthLock[]         @relation("LockOwner")
  locksDone          MonthLock[]         @relation("LockedBy")
  requests           ValidationRequest[] @relation("Requester")
  decisions          ValidationRequest[] @relation("Decider")
  comments           Comment[]
  changes            ChangeLog[]
  uploads            Attachment[]
  decisionsTaken     Decision[]         @relation("DecisionAuthor")
  contactsCreated    Contact[]          @relation("ContactCreator")
  contactLists       ContactList[]      @relation("ContactListOwner")
  membershipsCreated Membership[]       @relation("MembershipCreator")
  decisionsFollowed  Decision[]         @relation("DecisionFollowUp")
  tasks              Task[]
  taskLists          TaskList[]
  notes              Note[]
  noteShares         NoteShare[]
  loadFreezes        LoadFreeze[]
  proposalsWritten   ChangeProposal[]   @relation("ProposalAuthor")
  proposalsDecided   ChangeProposal[]   @relation("ProposalDecider")
  achievements       Achievement[]
  requestsMade       Request[]          @relation("RequestRequester")
  requestsAssigned   Request[]          @relation("RequestAssignee")
  servicesDone       Expense[]          @relation("ServiceDoneBy")
  plannedLoads       PlannedLoad[]
  sponsoredEditions  Edition[]          @relation("EditionSponsor")
  remarksWritten     FieldRemark[]      @relation("RemarkAuthor")
  remarksResolved    FieldRemark[]      @relation("RemarkResolver")
  notifications      Notification[]     @relation("NotificationRecipient")
  notificationsSent  Notification[]     @relation("NotificationSender")
}

// ---- Comptes et sessions (lot F) : tables attendues par better-auth (adaptateur Prisma). Ne pas renommer les champs. ----
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime? // posé à chaque ouverture de session (journal des connexions, EF-K4)
  sessions      Session[]
  accounts      Account[]
  person        Person?
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String // "credential" pour e-mail / mot de passe ; demain "microsoft" (Entra ID)
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // hachage (scrypt, better-auth) — jamais le mot de passe
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// Boîte d'envoi (lot F) : tant que les mails ne sont pas branchés (V1), tout courrier sortant est déposé ici — lien de
// réinitialisation, invitation — et l'admin le remet à la personne. En V1, un envoi SMTP / Graph vide cette boîte.
model MailOutbox {
  id        String    @id @default(cuid())
  kind      String // password_reset | invitation | other
  to        String
  subject   String
  body      String
  link      String?
  createdAt DateTime  @default(now())
  sentAt    DateTime?
  handedAt  DateTime? // remis à la main par l'admin (copié / transmis)

  @@index([to])
}

model TimeCode {
  id      String           @id @default(cuid())
  code    String           @unique
  label   String
  kind    String // operating | non_worked
  order   Int              @default(0)
  persons PersonTimeCode[]
  entries TimeEntry[]
}

model PersonTimeCode {
  personId   String
  timeCodeId String
  person     Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  timeCode   TimeCode @relation(fields: [timeCodeId], references: [id], onDelete: Cascade)

  @@id([personId, timeCodeId])
}

model Mission {
  id       String    @id @default(cuid())
  name     String
  order    Int       @default(0)
  projects Project[]
}

// Organisations (lot E2, ex-Funder + Supplier) : un seul annuaire, des genres cumulables (`kinds`, séparés par des virgules :
// funder | supplier | partner | network | authority). Les relations gardent leur nom de rôle — le `funder` d'une ligne, d'une
// convention ou d'un appel est l'organisation qui finance ; le `supplierRef` d'une validation est celle qui fournit.
model Organisation {
  id          String          @id @default(cuid())
  name        String          @unique
  kinds       String          @default("partner")
  siret       String?
  website     String?
  address     String?
  email       String? // adresse générique (fournisseur : où envoyer le bon pour accord)
  phone       String?
  notes       String? // périmètre, habitudes, calendrier d'appels à projets…
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  lines       FundingLine[]
  conventions Convention[]
  contacts    Contact[]
  calls       Call[]
  memberships Membership[]
  validations ValidationRequest[]
  editions    EditionPartner[]
}

// Contacts (lot « Contacts et listes », 18/09) : toute personne extérieure à l'équipe — interlocuteur d'un financeur, d'un
// fournisseur, invité, membre d'un réseau… Organisation facultative (ou un nom de structure en texte) ; tags libres ;
// données personnelles de tiers : le minimum utile. Un contact parti se détache (`leftAt`), il ne s'efface pas tant qu'un
// dossier le cite. Prêt pour Brevo (identifiant, statut RGPD) sans que rien ne soit branché.
model Contact {
  id               String        @id @default(cuid())
  organisationId   String?
  organisation     Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  organisationName String? // structure en texte quand elle n'est pas dans l'annuaire
  firstName        String?
  lastName         String
  role             String? // fonction
  email            String?
  phone            String?
  address          String?
  postcode         String?
  city             String?
  tags             String        @default("") // mots-clés, séparés par des virgules
  notes            String?
  primary          Boolean       @default(false) // contact principal de son organisation
  leftAt           DateTime?
  brevoContactId   String?       @unique
  brevoStatus      String? // null = hors Brevo ; active | unsubscribed (désinscrit·e, RGPD) | deleted (disparu·e de Brevo)
  brevoAttributes  String        @default("{}") // attributs Brevo non repris dans les colonnes communes (JSON, nom → valeur)
  brevoSyncedAt    DateTime?
  createdById      String?
  createdBy        Person?       @relation("ContactCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @default(now()) @updatedAt
  lines            FundingLine[]
  conventions      Convention[]
  listItems        ContactListItem[]
  memberships      Membership[]

  @@index([organisationId])
  @@index([email])
}

// Liste de contacts : invités d'un événement, réseau sur une thématique, annuaire d'un projet… À son auteur, avec une
// visibilité (privée, mon responsable, mon pôle, toute la CRESS), une édition facultative, et ses propres colonnes
// (`fields`, JSON : [{ key, label, type: bool | text | date | select, options? }]) dont les valeurs vivent sur chaque ligne.
model ContactList {
  id          String   @id @default(cuid())
  ownerId     String
  owner       Person   @relation("ContactListOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  visibility  String   @default("private") // private | pole_lead | pole | all
  color       String?
  editionId   String?
  edition     Edition? @relation(fields: [editionId], references: [id], onDelete: SetNull)
  fields      String   @default("[]")
  // Connecteur Brevo : une liste `source = brevo` est le miroir d'une liste Brevo (membres tenus par la synchronisation, colonnes
  // = attributs Brevo, en lecture) ; une liste `manual` envoyée vers Brevo garde l'identifiant de la liste créée là-bas.
  source        String    @default("manual") // manual | brevo | helloasso
  brevoListId   Int?      @unique
  brevoSyncedAt DateTime? // dernière synchronisation (source brevo) ou dernier envoi (source manual)
  helloAssoForm String?   @unique // source helloasso : slug du formulaire (événement) dont les inscrits sont tenus en miroir
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  items       ContactListItem[]

  @@index([ownerId])
}

model ContactListItem {
  listId    String
  list      ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  role      String? // ce qu'il ou elle est dans cette liste (invité, intervenant, membre…)
  values    String      @default("{}") // valeurs des colonnes propres à la liste (JSON, clé → valeur)
  addedAt   DateTime    @default(now())

  @@id([listId, contactId])
}

// Partenaires d'une édition (lot E2) : des organisations liées, en plus du texte libre `Edition.partners` qui reste le repli.
model EditionPartner {
  editionId      String
  edition        Edition      @relation(fields: [editionId], references: [id], onDelete: Cascade)
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  role           String? // ce que fait le partenaire sur cette édition
  createdAt      DateTime     @default(now())

  @@id([editionId, organisationId])
}

// Convention : objet unique par financeur et dispositif, pouvant couvrir plusieurs années et plusieurs projets (EF-C3).
// Les lignes de financement des éditions sont ses affectations ; leur somme ne doit pas dépasser le montant notifié.
model Convention {
  id              String        @id @default(cuid())
  funderId        String
  funder          Organisation        @relation(fields: [funderId], references: [id])
  reference       String // référence interne unique, ex. FSE-2026-2028
  scheme          String?
  label           String?
  startYear       Int
  endYear         Int
  status          String        @default("to_submit") // to_submit | submitted | notified | contracted | justified
  amountRequested Float?
  amountNotified  Float?
  submittedAt     DateTime?
  notifiedAt      DateTime?
  signedAt        DateTime?
  notes           String?
  contactId       String? // contact du dossier ; sinon le contact principal du financeur
  contact         Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lines           FundingLine[]
  payments        Payment[]
  call            Call?
  createdAt       DateTime      @default(now())

  @@unique([reference])
}

// Listes de valeurs modifiables (statuts, états, rôles, rythmes, natures de validation…)
model RefValue {
  id     String  @id @default(cuid())
  family String
  code   String
  label  String
  color  String?
  order  Int     @default(0)

  @@unique([family, code])
}

model Project {
  id            String    @id @default(cuid())
  name          String
  analyticCode  String
  poleId        String
  pole          Pole      @relation(fields: [poleId], references: [id])
  pilotId       String
  pilot         Person    @relation("ProjectPilot", fields: [pilotId], references: [id])
  guarantorId   String?
  guarantor     Person?   @relation("ProjectGuarantor", fields: [guarantorId], references: [id])
  missionId     String
  mission       Mission   @relation(fields: [missionId], references: [id])
  strategicAxis String?
  recurring     Boolean   @default(true)
  createdAt     DateTime  @default(now())
  editions      Edition[]
  timeEntries   TimeEntry[]
  secondaryPoles ProjectPole[] // pôles associés (projets communs) ; le pôle principal est celui du pilote
}

// Pôle secondaire d'un projet commun : ses membres le voient dans leur périmètre, son responsable y a ses droits de garant.
model ProjectPole {
  projectId String
  poleId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pole      Pole    @relation(fields: [poleId], references: [id], onDelete: Cascade)

  @@id([projectId, poleId])
}

model Edition {
  id               String    @id @default(cuid())
  projectId        String
  project          Project   @relation(fields: [projectId], references: [id])
  year             Int
  status           String    @default("proposed") // rechallenged | proposed | validated | in_progress | closed
  decisionDate     DateTime?
  conditionalStart Boolean   @default(false)

  // Couche 1 — cadre stratégique (direction)
  stakes          String?
  axis            String?
  sressMeasure    String?
  snessLink       String? // rattachement à la SNESS (gabarit fiche projet)
  otherTexts      String? // autres textes de rattachement
  yearPriorities  String?
  expectedOutcome String? // impacts attendus

  // Couche 2 — cadre de moyens (RAF + direction)
  plannedFunders        String?
  directExpenseEnvelope Float?
  fte                   Float?
  imposedIndicators     String?
  sponsorId             String? // sponsor de la fiche projet (membre du CODIR)
  sponsor               Person?   @relation("EditionSponsor", fields: [sponsorId], references: [id])

  // Couche 3 — proposition opérationnelle (pilote)
  operationalObjectives String? // objectifs qualitatifs (quelle problématique)
  quantitativeObjectives String? // objectifs quantitatifs
  content               String? // contenu développé, valeur ajoutée
  audience              String? // public, bénéficiaires
  calendar              String?
  deliveryDate          DateTime? // date de rendu
  partners              String?
  partnerLinks          EditionPartner[]
  contactLists          ContactList[]
  method                String?
  governance            String?
  ownIndicators         String?
  timeNeed              String?
  budgetNeed            String?

  // Couche 4 — validation
  codirDecision  String? // renew | adjust | stop
  codirDate      DateTime?
  boardValidated Boolean   @default(false)
  boardDate      DateTime?

  // Au fil de l'année
  venues         String?
  equipment      String?
  evidenceToKeep String?
  evaluation     String?
  report         String?

  // Budget (écrit par la RAF)
  budgetEnvelope Float?
  committed      Float @default(0)
  spent          Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team         EditionTeam[]
  personDays   EditionPersonDays[]
  actions      Action[]
  fundingLines FundingLine[]
  validations  ValidationRequest[]
  docLinks     DocLink[]
  comments     Comment[]
  remarks      FieldRemark[]
  plannedLoads PlannedLoad[]
  changes      ChangeLog[]
  indicators   Indicator[]
  attachments  Attachment[]
  expenses     Expense[]
  decisions    Decision[]
  tasks        Task[]
  taskLists    TaskList[]
  notes        Note[]
  proposals    ChangeProposal[]
  achievements Achievement[]
  requests     Request[]

  @@unique([projectId, year])
}

model EditionTeam {
  editionId String
  personId  String
  edition   Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  person    Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([editionId, personId])
}

// Plan de charge : jours prévus d'une personne sur une édition, mois par mois. Sans ventilation, le total annuel
// (EditionPersonDays.plannedDays) se lisse sur les mois de l'édition ; avec, la somme des mois fait foi.
model PlannedLoad {
  id        String  @id @default(cuid())
  editionId String
  personId  String
  month     String // AAAA-MM
  days      Float
  edition   Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  person    Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([editionId, personId, month])
  @@index([personId, month])
}

model EditionPersonDays {
  id            String  @id @default(cuid())
  editionId     String
  personId      String
  soldDays      Float   @default(0) // jours mentionnés dans les conventions (référence financeur)
  plannedDays   Float   @default(0) // charge de travail prévue (jours), mesure de la charge
  availableDays Float?
  edition       Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  person        Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([editionId, personId])
}

model Action {
  id            String       @id @default(cuid())
  editionId     String
  edition       Edition      @relation(fields: [editionId], references: [id], onDelete: Cascade)
  name          String
  ownerId       String?
  owner         Person?      @relation(fields: [ownerId], references: [id])
  milestoneDate DateTime?
  timeTarget    Float? // heures
  state         String       @default("todo") // todo | doing | done | late
  fundingLineId String?
  fundingLine   FundingLine? @relation(fields: [fundingLineId], references: [id])
  order         Int          @default(0)
  isPublic      Boolean      @default(false) // événement public : flux agenda du site
  // Occurrence (petit-déjeuner, forum SPRO…) : contenu, lieu, participants — une action peut porter sa petite fiche et se dupliquer.
  description   String?
  venue         String?
  participants  String?
  achievements  Achievement[]
  timeEntries   TimeEntry[]
  validations   ValidationRequest[]
  tasks         Task[]
}

model FundingLine {
  id               String        @id @default(cuid())
  editionId        String
  edition          Edition       @relation(fields: [editionId], references: [id], onDelete: Cascade)
  funderId         String
  funder           Organisation        @relation(fields: [funderId], references: [id])
  conventionId     String? // affectation d'une convention partagée ; sinon financement annuel propre à l'édition
  convention       Convention?   @relation(fields: [conventionId], references: [id])
  scheme           String?
  status           String        @default("to_submit") // to_submit | submitted | notified | contracted | justified
  amountRequested  Float?
  amountGranted    Float?
  submittedAt      DateTime?
  answeredAt       DateTime?
  contractedAt     DateTime?
  analyticCode     String?
  allocationKeyRef String?
  multiYear        Boolean       @default(false)
  notes            String?
  contactId        String? // contact du dossier ; sinon le contact principal du financeur
  contact          Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deliverables     Deliverable[]
  actions          Action[]
  attachments      Attachment[]
  payments         Payment[]
}

model Deliverable {
  id            String      @id @default(cuid())
  fundingLineId String
  fundingLine   FundingLine @relation(fields: [fundingLineId], references: [id], onDelete: Cascade)
  label         String
  dueDate       DateTime
  done          Boolean     @default(false)
  doneAt        DateTime?
  attachments   Attachment[]
}

// Versement (lot A) : l'argent attendu puis reçu. Sur une ligne de financement dans le cas courant (un financeur, une édition,
// une année) ; sur une convention quand l'accord est pluriannuel ou multi-projets et se verse par tranches. Le statut
// attendu / reçu se lit de `receivedAt` (jamais stocké) ; « reçu » est posé par la RAF ou la direction, jamais automatiquement.
model Payment {
  id            String       @id @default(cuid())
  fundingLineId String?
  fundingLine   FundingLine? @relation(fields: [fundingLineId], references: [id], onDelete: Cascade)
  conventionId  String?
  convention    Convention?  @relation(fields: [conventionId], references: [id], onDelete: Cascade)
  label         String // acompte, solde, avance, tranche 2027…
  amount        Float
  expectedAt    DateTime
  receivedAt    DateTime?
  reference     String? // référence du virement, numéro de mandat
  note          String?
  createdAt     DateTime     @default(now())

  @@index([fundingLineId])
  @@index([conventionId])
  @@index([expectedAt])
}

model TimeEntry {
  id         String    @id @default(cuid())
  personId   String
  person     Person    @relation(fields: [personId], references: [id])
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id])
  actionId   String?
  action     Action?   @relation(fields: [actionId], references: [id])
  timeCodeId String?
  timeCode   TimeCode? @relation(fields: [timeCodeId], references: [id])
  date       DateTime
  hours      Float
  comment    String?
  locked     Boolean   @default(false)

  @@index([personId, date])
}

model MonthLock {
  id         String   @id @default(cuid())
  personId   String
  person     Person   @relation("LockOwner", fields: [personId], references: [id])
  month      String // AAAA-MM
  lockedById String
  lockedBy   Person   @relation("LockedBy", fields: [lockedById], references: [id])
  lockedAt   DateTime @default(now())

  @@unique([personId, month])
}

model ValidationRequest {
  id              String    @id @default(cuid())
  editionId       String
  edition         Edition   @relation(fields: [editionId], references: [id], onDelete: Cascade)
  actionId        String?
  action          Action?   @relation(fields: [actionId], references: [id])
  kind            String // quote | expense | sending | scope_change | funder_milestone
  label           String
  requesterId     String
  requester       Person    @relation("Requester", fields: [requesterId], references: [id])
  amount          Float?
  attachmentUrl   String?
  requiredLevel   Int       @default(1)
  status          String    @default("pending") // pending | approved | refused
  deciderId       String?
  decider         Person?   @relation("Decider", fields: [deciderId], references: [id])
  decidedAt       DateTime?
  decisionComment String?
  targetDelayDays Int       @default(5)
  // Devis : fournisseur et adresse pour le « bon pour accord » envoyé à la validation (lot 3, plus d'impression ni de tampon).
  supplier        String?
  supplierEmail   String?
  supplierId      String?
  supplierRef     Organisation? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  attachments     Attachment[]
  expense         Expense?
}

// Demande interne (retour du 14/09) : retour sur le site, besoin de chiffres, travail à faire, demande à l'assistante…
// Un seul canal, un état suivi ; une tâche peut en naître. L'achat / devis passe par la validation (même tableau).
model Request {
  id           String    @id @default(cuid())
  kind         String    @default("other") // site | data | work | assistant | com | other
  title        String
  body         String?
  requesterId  String
  requester    Person    @relation("RequestRequester", fields: [requesterId], references: [id])
  assigneeId   String?
  assignee     Person?   @relation("RequestAssignee", fields: [assigneeId], references: [id])
  poleId       String?
  pole         Pole?     @relation(fields: [poleId], references: [id])
  editionId    String?
  edition      Edition?  @relation(fields: [editionId], references: [id], onDelete: SetNull)
  dueDate      DateTime?
  status       String    @default("open") // open | doing | done | declined
  answer       String?
  doneAt       DateTime?
  createdAt    DateTime  @default(now())
  tasks        Task[]

  @@index([assigneeId, status])
  @@index([poleId, status])
}

model Settings {
  id                        Int    @id @default(1)
  validationThresholdLevel1 Float  @default(500)
  validationThresholdLevel2 Float  @default(3000)
  reminderDaysBefore        String @default("30,7")
  envelopeAlertPercent      Int    @default(80)
  deliverableAlertDays      Int    @default(30)
  timeVisibility            String @default("self_pole_lead_raf") // self | self_pole_lead_raf | codir | all
  horizonDays               Int    @default(90)
  // Dernier passage de la passerelle échéances → notifications (lib/deadline-notifications.ts) : une échéance découverte
  // après ce passage est notifiée à ce moment-là, pas à la date théorique du palier.
  deadlineSyncAt            DateTime?
  timeRules                 String @default("")
  // Gabarit du chemin du dossier de référence sur le serveur ({code}, {annee})
  serverPathTemplate        String @default("\\\\cress\\Partage\\Action\\{code}\\{annee}")
  teamIcsToken              String? // jeton du flux agenda équipe (.ics)
  apiToken                  String? // jeton des exports pour Excel / outils externes
  hoursPerDay               Float   @default(7) // coefficient heures → jours, avec son origine dans la notice
  // Jours de fonctionnement par mois (réunions transverses, café, entretiens…) déduits de la capacité du plan de charge (S14 : 9 j / 86).
  operatingDaysPerMonth     Float   @default(0)
  // Adresse de facturation écrite sur le bon pour accord (lot 3) : les factures y arrivent, pas chez le pilote.
  billingEmail              String  @default("factures@cress-cvl.example")
  billingNote               String  @default("Merci d'adresser la facture à cette adresse, en rappelant la référence du devis et le nom du projet.")
  // Modules activés pour cette installation (lot 0, docs/produit.md) : un module éteint disparaît de la navigation et de ses
  // adresses, ses données restent. Distinct de Person.modules (choix de chacun). Aujourd'hui : veille.
  modules                   String  @default("veille,adherents")
  // Réalisé comptable (lot D) : quelle source alimente le « réalisé » des alertes d'enveloppe et du portefeuille —
  // raf = saisi par la RAF sur les dépenses (Expense.spent) ; ledger = le grand livre analytique importé. L'autre s'affiche en regard.
  realizedSource            String  @default("raf")
  // Axes analytiques Pennylane retenus (libellés, séparés par des virgules) ; vide = toutes les lignes.
  pennylaneAxes             String  @default("")
  // Connecteur Brevo (clé dans l'environnement, BREVO_API_KEY) : dernière synchronisation et son compte rendu.
  brevoSyncedAt             DateTime?
  brevoSyncReport           String?
  // Connecteur HelloAsso (identifiants dans l'environnement) : dernière synchronisation et son compte rendu.
  helloAssoSyncedAt         DateTime?
  helloAssoSyncReport       String?
}

// Adhésions (module « adherents », 18/09) : une adhésion = une organisation (ou une personne de l'annuaire) × une année,
// avec son collège, sa cotisation et son règlement. Le membre lui-même reste une organisation de l'annuaire (genre
// « member ») ou un contact : pas de table à part pour l'identité. Une adhésion venue de HelloAsso garde l'identifiant de
// l'item (idempotence) ; les autres sont saisies à la main.
model Membership {
  id              String        @id @default(cuid())
  organisationId  String?
  organisation    Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contactId       String? // personne physique adhérente, ou référent·e de la structure
  contact         Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  year            Int
  college         String? // collège ou tarif (référentiel « college », texte libre accepté)
  amount          Float         @default(0)
  status          String        @default("due") // due (à régler) | paid (réglée) | exempt (exonérée) | cancelled (annulée)
  paidAt          DateTime?
  method          String? // helloasso | transfer | cheque | cash | other
  helloAssoItemId String?       @unique
  helloAssoForm   String? // slug du formulaire HelloAsso d'origine
  notes           String?
  createdById     String?
  createdBy       Person?       @relation("MembershipCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt

  @@index([year])
  @@index([organisationId])
  @@index([contactId])
}

// Réalisé comptable (lot D) : snapshot agrégé du grand livre analytique, par source (fichier importé, Pennylane…), rapproché
// des éditions par le code analytique — **aucune clé étrangère** : une édition sans code n'a simplement pas de réalisé.
// Idempotent : réimporter un exercice remplace ses lignes pour cette source, sans doublon (patron LigneRealise d'erp-tlst).
model LedgerLine {
  id            String   @id @default(cuid())
  source        String // file | pennylane
  analyticCode  String
  accountNumber String // 6x charges, 7x produits ; 625x = déplacements, missions, réceptions (frais)
  accountLabel  String?
  year          Int
  debit         Float    @default(0)
  credit        Float    @default(0)
  detail        String? // JSON : pièces (date, pièce, tiers, libellé, débit, crédit)
  importedAt    DateTime @default(now())

  @@unique([source, analyticCode, accountNumber, year])
  @@index([analyticCode, year])
}

// Correspondance d'un code analytique vers un objet de l'outil quand le code n'est ni celui d'un projet ni celui d'une ligne de
// financement : une édition précise, une action, ou un code de fonctionnement à ignorer. Tenue dans l'admin.
model AnalyticTag {
  code       String   @id
  targetKind String // project | edition | action | fundingLine | ignore
  targetId   String?
  note       String?
  createdAt  DateTime @default(now())
}

// Journal des imports du réalisé : qui, quand, quelle source, quel exercice, combien de lignes.
model LedgerImport {
  id         String   @id @default(cuid())
  source     String
  year       Int
  fileName   String?
  lines      Int
  rows       Int
  byId       String?
  importedAt DateTime @default(now())
}

// Appel à projets (lot B, module « veille ») : une opportunité de financement repérée, avant qu'elle devienne une convention.
// Le contenu (libellé, échéance, lien) est celui de l'appel ; le statut d'équipe (à étudier, on dépose, écarté) appartient à la
// CRESS et ne serait jamais touché par un flux importé. Un appel promu garde le lien vers sa convention ; un appel passé ou
// retiré reste en base (actif = false), il n'est pas supprimé.
model Call {
  id           String      @id @default(cuid())
  funderId     String
  funder       Organisation      @relation(fields: [funderId], references: [id], onDelete: Cascade)
  label        String
  scheme       String? // dispositif, axe
  deadline     DateTime? // date limite de dépôt ; null si au fil de l'eau
  rolling      Boolean     @default(false) // au fil de l'eau
  recurring    Boolean     @default(false) // revient chaque année : « reconduire » crée l'appel de l'année suivante
  amountHint   String? // montant indicatif, en texte (« jusqu'à 30 k€ », « 50 % des dépenses »)
  link         String?
  note         String?
  teamStatus   String? // study | apply | dismissed ; null = pas encore regardé
  statusById   String?
  statusAt     DateTime?
  conventionId String?     @unique // convention créée depuis cet appel (« Étudier »)
  convention   Convention? @relation(fields: [conventionId], references: [id], onDelete: SetNull)
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())

  @@index([funderId])
  @@index([deadline])
  @@index([teamStatus])
}

// Plan de charge figé par année (au séminaire) : après cette date, les modifications restent possibles mais sont tracées et signalées.
model LoadFreeze {
  year       Int      @id
  frozenAt   DateTime @default(now())
  frozenById String
  frozenBy   Person   @relation(fields: [frozenById], references: [id])
  note       String?
}

// Proposition de modification d'une fiche validée (retour du 14/09) : rien ne change en silence. Qui, quoi, pourquoi ;
// le pilote (ou la direction) accepte, la valeur s'applique et l'historique le garde.
model ChangeProposal {
  id          String    @id @default(cuid())
  editionId   String
  edition     Edition   @relation(fields: [editionId], references: [id], onDelete: Cascade)
  field       String
  proposed    String
  reason      String
  authorId    String
  author      Person    @relation("ProposalAuthor", fields: [authorId], references: [id])
  status      String    @default("pending") // pending | accepted | refused
  decidedById String?
  decidedBy   Person?   @relation("ProposalDecider", fields: [decidedById], references: [id])
  decidedAt   DateTime?
  comment     String?
  createdAt   DateTime  @default(now())

  @@index([editionId, status])
}

// Réalisation consignée au fil de l'année (retour du 14/09) : inscrits, publics touchés, livrable produit, retombée…
// Reprise dans le tableau de bord de l'édition et dans l'export bilan. Un chiffre facultatif, une date, un libellé.
model Achievement {
  id        String   @id @default(cuid())
  editionId String
  edition   Edition  @relation(fields: [editionId], references: [id], onDelete: Cascade)
  actionId  String?
  action    Action?  @relation(fields: [actionId], references: [id], onDelete: SetNull)
  kind      String   @default("other") // participants | audience | deliverable | press | partner | other
  label     String
  value     Float?
  unit      String?
  date      DateTime @default(now())
  authorId  String
  author    Person   @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  @@index([editionId, date])
}

model DocLink {
  id        String  @id @default(cuid())
  editionId String
  edition   Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  label     String
  url       String
  codirOnly Boolean @default(false)
}

model Comment {
  id        String   @id @default(cuid())
  editionId String
  edition   Edition  @relation(fields: [editionId], references: [id], onDelete: Cascade)
  authorId  String
  author    Person   @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

model ChangeLog {
  id        String   @id @default(cuid())
  editionId String
  edition   Edition  @relation(fields: [editionId], references: [id], onDelete: Cascade)
  field     String
  before    String?
  after     String?
  authorId  String
  author    Person   @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
}

model Indicator {
  id        String  @id @default(cuid())
  editionId String
  edition   Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  label     String
  target    String?
  actual    String?
  imposed   Boolean @default(false)
  order     Int     @default(0)
}

// Pièces jointes légères (EF-J1) : devis, convention, notification, justificatif, bilan remis… rattachées à l'édition
// et, au besoin, à une ligne de financement, un livrable ou une demande de validation. Pas de GED : le dossier reste sur le serveur.
model Attachment {
  id            String             @id @default(cuid())
  editionId     String
  edition       Edition            @relation(fields: [editionId], references: [id], onDelete: Cascade)
  fundingLineId String?
  fundingLine   FundingLine?       @relation(fields: [fundingLineId], references: [id])
  deliverableId String?
  deliverable   Deliverable?       @relation(fields: [deliverableId], references: [id])
  validationId  String?
  validation    ValidationRequest? @relation(fields: [validationId], references: [id])
  kind          String // quote | contract | notification | receipt | report_sent | minutes | other (référentiel attachment_kind)
  label         String
  fileName      String
  storedName    String             @unique
  mimeType      String
  size          Int
  uploadedById  String
  uploadedBy    Person             @relation(fields: [uploadedById], references: [id])
  createdAt     DateTime           @default(now())
}

// Rythmes de travail (accord d'entreprise) : heures par jour, semaine paire / impaire (option B : un vendredi sur deux).
model Rhythm {
  id        String               @id @default(cuid())
  code      String               @unique
  label     String
  hoursEven String // 7 valeurs lundi→dimanche, semaine paire, ex. "7.5,7.5,7.5,7.5,6.5,0,0"
  hoursOdd  String // idem semaine impaire
  order     Int                  @default(0)
  periods   PersonRhythmPeriod[]
}

// Le rythme d'une personne peut changer (passage à temps partiel, changement d'option) : périodes d'effet.
model PersonRhythmPeriod {
  id       String    @id @default(cuid())
  personId String
  person   Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  rhythmId String
  rhythm   Rhythm    @relation(fields: [rhythmId], references: [id])
  from     DateTime
  to       DateTime?
}

// Déclaration « cette semaine est complète » par la personne, avant la clôture de la RAF.
model WeekDeclaration {
  id         String   @id @default(cuid())
  personId   String
  person     Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  week       String // AAAA-Wnn
  declaredAt DateTime @default(now())

  @@unique([personId, week])
}

// Dépense directe : un devis approuvé crée l'engagement une seule fois ; le réalisé rattaché ne compte pas deux fois.
model Expense {
  id           String             @id @default(cuid())
  editionId    String
  edition      Edition            @relation(fields: [editionId], references: [id], onDelete: Cascade)
  label        String
  supplier     String?
  committed    Float              @default(0) // montant engagé (devis approuvé)
  spent        Float              @default(0) // réalisé rattaché (factures), saisi par la RAF
  status       String             @default("open") // open | closed (reliquat soldé ou annulé)
  reference    String?
  validationId String?            @unique
  validation   ValidationRequest? @relation(fields: [validationId], references: [id])
  // Circuit facture (lot 3) : nature analytique, facture reçue, service fait par le pilote (non bloquant), payée.
  nature          String?   // purchase | investment | service
  invoiceReceivedAt DateTime?
  serviceDoneAt   DateTime?
  serviceDoneById String?
  serviceDoneBy   Person?   @relation("ServiceDoneBy", fields: [serviceDoneById], references: [id])
  paidAt          DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

// Décision d'instance (CODIR, réunion de pôle, revue trimestrielle, CA) consignée sur l'édition, datée (EF-F4, EF-H2, EF-H3).
model Decision {
  id            String    @id @default(cuid())
  editionId     String
  edition       Edition   @relation(fields: [editionId], references: [id], onDelete: Cascade)
  instance      String // codir | pole | quarterly | board
  body          String
  authorId      String
  author        Person    @relation("DecisionAuthor", fields: [authorId], references: [id])
  followUpId    String?
  followUp      Person?   @relation("DecisionFollowUp", fields: [followUpId], references: [id])
  dueDate       DateTime?
  decidedAt     DateTime  @default(now())
  alertKind     String? // alerte de l'édition que cette décision règle (envelope, time_over…) : elle s'éteint dans la bande d'état
}

// Notification dans l'outil (cloche) : relance de temps, information. Dans le prototype, pas de mail : tout passe par ici.
model Notification {
  id        String    @id @default(cuid())
  personId  String
  person    Person    @relation("NotificationRecipient", fields: [personId], references: [id], onDelete: Cascade)
  senderId  String?
  sender    Person?   @relation("NotificationSender", fields: [senderId], references: [id])
  kind      String // time_reminder | info | deadline
  title     String
  body      String?
  link      String?
  // Clé d'idempotence des notifications générées (échéances J-30 / J-7 / retard) : une seule par personne et par palier franchi.
  dedupeKey String?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@unique([personId, dedupeKey])
  @@index([personId, readAt])
}

// Tâche personnelle (to-do privée) : libellé, échéance facultative, rattachement facultatif à une édition ou une action.
// La personne est portée en base pour cloisonner ; à l'écran, c'est toujours la personne connectée, jamais un choix.
model Task {
  id        String     @id @default(cuid())
  personId  String
  person    Person     @relation(fields: [personId], references: [id], onDelete: Cascade)
  label     String
  description String? // quelques lignes sous le libellé (redesign du 18/09, inspiration Todoist)
  dueDate   DateTime?
  done      Boolean    @default(false)
  doneAt    DateTime?
  editionId String?
  edition   Edition?   @relation(fields: [editionId], references: [id], onDelete: SetNull)
  actionId  String?
  action    Action?    @relation(fields: [actionId], references: [id], onDelete: SetNull)
  listId    String?
  list      TaskList?  @relation(fields: [listId], references: [id], onDelete: SetNull)
  requestId String? // tâche née d'une demande prise (« Je m'en occupe ») : cocher la tâche fait la demande, et inversement
  request   Request?   @relation(fields: [requestId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())
  slots     WorkSlot[]

  @@index([personId, done])
}

// Liste de tâches (catégorie) : avec ou sans projet ; visibilité au choix de son auteur (private | pole_lead | pole | all).
// Seul l'auteur écrit dedans ; les autres lisent quand la visibilité le permet.
model TaskList {
  id         String   @id @default(cuid())
  personId   String
  person     Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  name       String
  visibility String   @default("private")
  color      String?  // repère visuel, même palette que les notes (lib/notes.ts NOTE_COLORS)
  editionId  String?
  edition    Edition? @relation(fields: [editionId], references: [id], onDelete: SetNull)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  tasks      Task[]

  @@index([personId])
}

// Note de réunion ou note libre : rattachée à une édition ou transverse (réunion d'équipe, café du lundi) ; privée ou partagée.
model Note {
  id         String   @id @default(cuid())
  authorId   String
  author     Person   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title      String
  body       String   @default("")
  date       DateTime @default(now())
  context    String   @default("project") // project | team | pole | cafe | other
  editionId  String?
  edition    Edition? @relation(fields: [editionId], references: [id], onDelete: SetNull)
  visibility String   @default("private") // private | pole | all
  color      String?  // repère visuel choisi par l'auteur : bleu | vert | ocre | corail | violet | gris (lib/notes.ts NOTE_COLORS)
  archivedAt DateTime? // archivée par son auteur : sort des listes, reste lisible dans « Archivées »
  shares     NoteShare[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([authorId])
  @@index([editionId])
}

// Partage nominatif d'une note (retour du 14/09) : en plus de la visibilité, l'auteur nomme des collègues qui la lisent.
model NoteShare {
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([noteId, personId])
  @@index([personId])
}

// Créneau de travail posé sur une tâche : une journée entière (allDay) ou une plage horaire (de 9 h à 11 h le 23/09).
// Distinct de l'échéance : la deadline dit « pour quand », le créneau dit « quand je m'y mets ». Apparaît dans le flux agenda, comme « occupé ».
model WorkSlot {
  id      String   @id @default(cuid())
  taskId  String
  task    Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  startAt DateTime
  endAt   DateTime
  allDay  Boolean  @default(false)

  @@index([taskId])
}

// Remarque sur une rubrique de la fiche (comme un commentaire Word accroché à un paragraphe) : la direction, la RAF ou le
// responsable de pôle garant l'écrit, le pilote la lit en place et la marque traitée. Elle reste dans l'historique.
model FieldRemark {
  id           String    @id @default(cuid())
  editionId    String
  edition      Edition   @relation(fields: [editionId], references: [id], onDelete: Cascade)
  field        String // clé du champ de la fiche (stakes, calendar…)
  body         String
  // Motif (retour du 14/09, Simon : « je ne sais pas d'où ça vient, pourquoi ») : funder | strategy | feasibility | form | other
  reason       String    @default("other")
  authorId     String
  author       Person    @relation("RemarkAuthor", fields: [authorId], references: [id])
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   Person?   @relation("RemarkResolver", fields: [resolvedById], references: [id])

  @@index([editionId, resolvedAt])
}

