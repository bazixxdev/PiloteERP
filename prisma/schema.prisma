// Schéma du prototype « Pilote ». SQLite pour la démo, portable vers Postgres
// (aucun type spécifique SQLite ; les listes de valeurs sont des tables).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Pole {
  id       String    @id @default(cuid())
  name     String
  leadId   String?
  lead     Person?   @relation("PoleLead", fields: [leadId], references: [id])
  members  Person[]  @relation("PoleMembers")
  projects Project[]
  secondaryOf ProjectPole[]
}

model Person {
  id            String   @id @default(cuid())
  name          String
  poleId        String?
  pole          Pole?    @relation("PoleMembers", fields: [poleId], references: [id])
  role          String // pilot | contributor | pole_lead | director | raf | assistant
  workRhythm    String // option_a | option_b | part_time | apprentice
  availableDays Int      @default(200)
  active        Boolean  @default(true)
  order         Int      @default(0)
  icsToken      String?  @unique // jeton du flux agenda personnel (.ics)
  rhythmPeriods PersonRhythmPeriod[]
  weekDeclarations WeekDeclaration[]

  ledPoles           Pole[]              @relation("PoleLead")
  timeCodes          PersonTimeCode[]
  pilotedProjects    Project[]           @relation("ProjectPilot")
  guaranteedProjects Project[]           @relation("ProjectGuarantor")
  teams              EditionTeam[]
  personDays         EditionPersonDays[]
  actions            Action[]
  timeEntries        TimeEntry[]
  monthLocks         MonthLock[]         @relation("LockOwner")
  locksDone          MonthLock[]         @relation("LockedBy")
  requests           ValidationRequest[] @relation("Requester")
  decisions          ValidationRequest[] @relation("Decider")
  comments           Comment[]
  changes            ChangeLog[]
  uploads            Attachment[]
  decisionsTaken     Decision[]         @relation("DecisionAuthor")
  decisionsFollowed  Decision[]         @relation("DecisionFollowUp")
  tasks              Task[]
  notifications      Notification[]     @relation("NotificationRecipient")
  notificationsSent  Notification[]     @relation("NotificationSender")
}

model TimeCode {
  id      String           @id @default(cuid())
  code    String           @unique
  label   String
  kind    String // operating | non_worked
  order   Int              @default(0)
  persons PersonTimeCode[]
  entries TimeEntry[]
}

model PersonTimeCode {
  personId   String
  timeCodeId String
  person     Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  timeCode   TimeCode @relation(fields: [timeCodeId], references: [id], onDelete: Cascade)

  @@id([personId, timeCodeId])
}

model Mission {
  id       String    @id @default(cuid())
  name     String
  order    Int       @default(0)
  projects Project[]
}

model Funder {
  id          String          @id @default(cuid())
  name        String          @unique
  notes       String? // périmètre, habitudes, calendrier d'appels à projets…
  lines       FundingLine[]
  conventions Convention[]
  contacts    FunderContact[]
}

// Interlocuteurs d'un financeur (instructeur, gestionnaire, élu référent…). Données personnelles de tiers : le minimum utile,
// tenu par la RAF ; le contact principal sert par défaut, une ligne ou une convention peut désigner son propre contact du dossier.
model FunderContact {
  id        String        @id @default(cuid())
  funderId  String
  funder    Funder        @relation(fields: [funderId], references: [id], onDelete: Cascade)
  firstName String?
  lastName  String
  role      String? // fonction
  email     String?
  phone     String?
  notes     String?
  primary   Boolean       @default(false)
  createdAt DateTime      @default(now())
  lines     FundingLine[]
  conventions Convention[]

  @@index([funderId])
}

// Convention : objet unique par financeur et dispositif, pouvant couvrir plusieurs années et plusieurs projets (EF-C3).
// Les lignes de financement des éditions sont ses affectations ; leur somme ne doit pas dépasser le montant notifié.
model Convention {
  id              String        @id @default(cuid())
  funderId        String
  funder          Funder        @relation(fields: [funderId], references: [id])
  reference       String // référence interne unique, ex. FSE-2026-2028
  scheme          String?
  label           String?
  startYear       Int
  endYear         Int
  status          String        @default("to_submit") // to_submit | submitted | notified | contracted | justified
  amountRequested Float?
  amountNotified  Float?
  submittedAt     DateTime?
  notifiedAt      DateTime?
  signedAt        DateTime?
  notes           String?
  contactId       String? // contact du dossier ; sinon le contact principal du financeur
  contact         FunderContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  lines           FundingLine[]
  createdAt       DateTime      @default(now())

  @@unique([reference])
}

// Listes de valeurs modifiables (statuts, états, rôles, rythmes, natures de validation…)
model RefValue {
  id     String  @id @default(cuid())
  family String
  code   String
  label  String
  color  String?
  order  Int     @default(0)

  @@unique([family, code])
}

model Project {
  id            String    @id @default(cuid())
  name          String
  analyticCode  String
  poleId        String
  pole          Pole      @relation(fields: [poleId], references: [id])
  pilotId       String
  pilot         Person    @relation("ProjectPilot", fields: [pilotId], references: [id])
  guarantorId   String?
  guarantor     Person?   @relation("ProjectGuarantor", fields: [guarantorId], references: [id])
  missionId     String
  mission       Mission   @relation(fields: [missionId], references: [id])
  strategicAxis String?
  recurring     Boolean   @default(true)
  createdAt     DateTime  @default(now())
  editions      Edition[]
  timeEntries   TimeEntry[]
  secondaryPoles ProjectPole[] // pôles associés (projets communs) ; le pôle principal est celui du pilote
}

// Pôle secondaire d'un projet commun : ses membres le voient dans leur périmètre, son responsable y a ses droits de garant.
model ProjectPole {
  projectId String
  poleId    String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pole      Pole    @relation(fields: [poleId], references: [id], onDelete: Cascade)

  @@id([projectId, poleId])
}

model Edition {
  id               String    @id @default(cuid())
  projectId        String
  project          Project   @relation(fields: [projectId], references: [id])
  year             Int
  status           String    @default("proposed") // rechallenged | proposed | validated | in_progress | closed
  decisionDate     DateTime?
  conditionalStart Boolean   @default(false)

  // Couche 1 — cadre stratégique (direction)
  stakes          String?
  axis            String?
  sressMeasure    String?
  yearPriorities  String?
  expectedOutcome String?

  // Couche 2 — cadre de moyens (RAF + direction)
  plannedFunders        String?
  directExpenseEnvelope Float?
  fte                   Float?
  imposedIndicators     String?

  // Couche 3 — proposition opérationnelle (pilote)
  operationalObjectives String?
  calendar              String?
  partners              String?
  method                String?
  governance            String?
  ownIndicators         String?
  timeNeed              String?
  budgetNeed            String?

  // Couche 4 — validation
  codirDecision  String? // renew | adjust | stop
  codirDate      DateTime?
  boardValidated Boolean   @default(false)
  boardDate      DateTime?

  // Au fil de l'année
  venues         String?
  equipment      String?
  evidenceToKeep String?
  evaluation     String?
  report         String?

  // Budget (écrit par la RAF)
  budgetEnvelope Float?
  committed      Float @default(0)
  spent          Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team         EditionTeam[]
  personDays   EditionPersonDays[]
  actions      Action[]
  fundingLines FundingLine[]
  validations  ValidationRequest[]
  docLinks     DocLink[]
  comments     Comment[]
  changes      ChangeLog[]
  indicators   Indicator[]
  attachments  Attachment[]
  expenses     Expense[]
  decisions    Decision[]
  tasks        Task[]

  @@unique([projectId, year])
}

model EditionTeam {
  editionId String
  personId  String
  edition   Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  person    Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([editionId, personId])
}

model EditionPersonDays {
  id            String  @id @default(cuid())
  editionId     String
  personId      String
  soldDays      Float   @default(0) // jours mentionnés dans les conventions (référence financeur)
  plannedDays   Float   @default(0) // charge de travail prévue (jours), mesure de la charge
  availableDays Float?
  edition       Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  person        Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([editionId, personId])
}

model Action {
  id            String       @id @default(cuid())
  editionId     String
  edition       Edition      @relation(fields: [editionId], references: [id], onDelete: Cascade)
  name          String
  ownerId       String?
  owner         Person?      @relation(fields: [ownerId], references: [id])
  milestoneDate DateTime?
  timeTarget    Float? // heures
  state         String       @default("todo") // todo | doing | done | late
  fundingLineId String?
  fundingLine   FundingLine? @relation(fields: [fundingLineId], references: [id])
  order         Int          @default(0)
  isPublic      Boolean      @default(false) // événement public : flux agenda du site
  timeEntries   TimeEntry[]
  validations   ValidationRequest[]
  tasks         Task[]
}

model FundingLine {
  id               String        @id @default(cuid())
  editionId        String
  edition          Edition       @relation(fields: [editionId], references: [id], onDelete: Cascade)
  funderId         String
  funder           Funder        @relation(fields: [funderId], references: [id])
  conventionId     String? // affectation d'une convention partagée ; sinon financement annuel propre à l'édition
  convention       Convention?   @relation(fields: [conventionId], references: [id])
  scheme           String?
  status           String        @default("to_submit") // to_submit | submitted | notified | contracted | justified
  amountRequested  Float?
  amountGranted    Float?
  submittedAt      DateTime?
  answeredAt       DateTime?
  contractedAt     DateTime?
  analyticCode     String?
  allocationKeyRef String?
  multiYear        Boolean       @default(false)
  notes            String?
  contactId        String? // contact du dossier ; sinon le contact principal du financeur
  contact          FunderContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deliverables     Deliverable[]
  actions          Action[]
  attachments      Attachment[]
}

model Deliverable {
  id            String      @id @default(cuid())
  fundingLineId String
  fundingLine   FundingLine @relation(fields: [fundingLineId], references: [id], onDelete: Cascade)
  label         String
  dueDate       DateTime
  done          Boolean     @default(false)
  doneAt        DateTime?
  attachments   Attachment[]
}

model TimeEntry {
  id         String    @id @default(cuid())
  personId   String
  person     Person    @relation(fields: [personId], references: [id])
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id])
  actionId   String?
  action     Action?   @relation(fields: [actionId], references: [id])
  timeCodeId String?
  timeCode   TimeCode? @relation(fields: [timeCodeId], references: [id])
  date       DateTime
  hours      Float
  comment    String?
  locked     Boolean   @default(false)

  @@index([personId, date])
}

model MonthLock {
  id         String   @id @default(cuid())
  personId   String
  person     Person   @relation("LockOwner", fields: [personId], references: [id])
  month      String // AAAA-MM
  lockedById String
  lockedBy   Person   @relation("LockedBy", fields: [lockedById], references: [id])
  lockedAt   DateTime @default(now())

  @@unique([personId, month])
}

model ValidationRequest {
  id              String    @id @default(cuid())
  editionId       String
  edition         Edition   @relation(fields: [editionId], references: [id], onDelete: Cascade)
  actionId        String?
  action          Action?   @relation(fields: [actionId], references: [id])
  kind            String // quote | expense | sending | scope_change | funder_milestone
  label           String
  requesterId     String
  requester       Person    @relation("Requester", fields: [requesterId], references: [id])
  amount          Float?
  attachmentUrl   String?
  requiredLevel   Int       @default(1)
  status          String    @default("pending") // pending | approved | refused
  deciderId       String?
  decider         Person?   @relation("Decider", fields: [deciderId], references: [id])
  decidedAt       DateTime?
  decisionComment String?
  targetDelayDays Int       @default(5)
  createdAt       DateTime  @default(now())
  attachments     Attachment[]
  expense         Expense?
}

model Settings {
  id                        Int    @id @default(1)
  validationThresholdLevel1 Float  @default(500)
  validationThresholdLevel2 Float  @default(3000)
  reminderDaysBefore        String @default("30,7")
  envelopeAlertPercent      Int    @default(80)
  deliverableAlertDays      Int    @default(30)
  timeVisibility            String @default("self_pole_lead_raf") // self | self_pole_lead_raf | codir | all
  horizonDays               Int    @default(90)
  timeRules                 String @default("")
  // Gabarit du chemin du dossier de référence sur le serveur ({code}, {annee})
  serverPathTemplate        String @default("\\\\cress\\Partage\\Action\\{code}\\{annee}")
  teamIcsToken              String? // jeton du flux agenda équipe (.ics)
  apiToken                  String? // jeton des exports pour Excel / outils externes
  hoursPerDay               Float   @default(7) // coefficient heures → jours, avec son origine dans la notice
}

model DocLink {
  id        String  @id @default(cuid())
  editionId String
  edition   Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  label     String
  url       String
  codirOnly Boolean @default(false)
}

model Comment {
  id        String   @id @default(cuid())
  editionId String
  edition   Edition  @relation(fields: [editionId], references: [id], onDelete: Cascade)
  authorId  String
  author    Person   @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

model ChangeLog {
  id        String   @id @default(cuid())
  editionId String
  edition   Edition  @relation(fields: [editionId], references: [id], onDelete: Cascade)
  field     String
  before    String?
  after     String?
  authorId  String
  author    Person   @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
}

model Indicator {
  id        String  @id @default(cuid())
  editionId String
  edition   Edition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  label     String
  target    String?
  actual    String?
  imposed   Boolean @default(false)
  order     Int     @default(0)
}

// Pièces jointes légères (EF-J1) : devis, convention, notification, justificatif, bilan remis… rattachées à l'édition
// et, au besoin, à une ligne de financement, un livrable ou une demande de validation. Pas de GED : le dossier reste sur le serveur.
model Attachment {
  id            String             @id @default(cuid())
  editionId     String
  edition       Edition            @relation(fields: [editionId], references: [id], onDelete: Cascade)
  fundingLineId String?
  fundingLine   FundingLine?       @relation(fields: [fundingLineId], references: [id])
  deliverableId String?
  deliverable   Deliverable?       @relation(fields: [deliverableId], references: [id])
  validationId  String?
  validation    ValidationRequest? @relation(fields: [validationId], references: [id])
  kind          String // quote | contract | notification | receipt | report_sent | minutes | other (référentiel attachment_kind)
  label         String
  fileName      String
  storedName    String             @unique
  mimeType      String
  size          Int
  uploadedById  String
  uploadedBy    Person             @relation(fields: [uploadedById], references: [id])
  createdAt     DateTime           @default(now())
}

// Rythmes de travail (accord d'entreprise) : heures par jour, semaine paire / impaire (option B : un vendredi sur deux).
model Rhythm {
  id        String               @id @default(cuid())
  code      String               @unique
  label     String
  hoursEven String // 7 valeurs lundi→dimanche, semaine paire, ex. "7.5,7.5,7.5,7.5,6.5,0,0"
  hoursOdd  String // idem semaine impaire
  order     Int                  @default(0)
  periods   PersonRhythmPeriod[]
}

// Le rythme d'une personne peut changer (passage à temps partiel, changement d'option) : périodes d'effet.
model PersonRhythmPeriod {
  id       String    @id @default(cuid())
  personId String
  person   Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  rhythmId String
  rhythm   Rhythm    @relation(fields: [rhythmId], references: [id])
  from     DateTime
  to       DateTime?
}

// Déclaration « cette semaine est complète » par la personne, avant la clôture de la RAF.
model WeekDeclaration {
  id         String   @id @default(cuid())
  personId   String
  person     Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  week       String // AAAA-Wnn
  declaredAt DateTime @default(now())

  @@unique([personId, week])
}

// Dépense directe : un devis approuvé crée l'engagement une seule fois ; le réalisé rattaché ne compte pas deux fois.
model Expense {
  id           String             @id @default(cuid())
  editionId    String
  edition      Edition            @relation(fields: [editionId], references: [id], onDelete: Cascade)
  label        String
  supplier     String?
  committed    Float              @default(0) // montant engagé (devis approuvé)
  spent        Float              @default(0) // réalisé rattaché (factures), saisi par la RAF
  status       String             @default("open") // open | closed (reliquat soldé ou annulé)
  reference    String?
  validationId String?            @unique
  validation   ValidationRequest? @relation(fields: [validationId], references: [id])
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

// Décision d'instance (CODIR, réunion de pôle, revue trimestrielle, CA) consignée sur l'édition, datée (EF-F4, EF-H2, EF-H3).
model Decision {
  id            String    @id @default(cuid())
  editionId     String
  edition       Edition   @relation(fields: [editionId], references: [id], onDelete: Cascade)
  instance      String // codir | pole | quarterly | board
  body          String
  authorId      String
  author        Person    @relation("DecisionAuthor", fields: [authorId], references: [id])
  followUpId    String?
  followUp      Person?   @relation("DecisionFollowUp", fields: [followUpId], references: [id])
  dueDate       DateTime?
  decidedAt     DateTime  @default(now())
}

// Notification dans l'outil (cloche) : relance de temps, information. Dans le prototype, pas de mail : tout passe par ici.
model Notification {
  id        String    @id @default(cuid())
  personId  String
  person    Person    @relation("NotificationRecipient", fields: [personId], references: [id], onDelete: Cascade)
  senderId  String?
  sender    Person?   @relation("NotificationSender", fields: [senderId], references: [id])
  kind      String // time_reminder | info
  title     String
  body      String?
  link      String?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  @@index([personId, readAt])
}

// Tâche personnelle (to-do privée) : libellé, échéance facultative, rattachement facultatif à une édition ou une action.
// La personne est portée en base pour cloisonner ; à l'écran, c'est toujours la personne connectée, jamais un choix.
model Task {
  id        String     @id @default(cuid())
  personId  String
  person    Person     @relation(fields: [personId], references: [id], onDelete: Cascade)
  label     String
  dueDate   DateTime?
  done      Boolean    @default(false)
  doneAt    DateTime?
  editionId String?
  edition   Edition?   @relation(fields: [editionId], references: [id], onDelete: SetNull)
  actionId  String?
  action    Action?    @relation(fields: [actionId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())
  slots     WorkSlot[]

  @@index([personId, done])
}

// Créneau de travail posé sur une tâche : une journée entière (allDay) ou une plage horaire (de 9 h à 11 h le 23/09).
// Distinct de l'échéance : la deadline dit « pour quand », le créneau dit « quand je m'y mets ». Apparaît dans le flux agenda, comme « occupé ».
model WorkSlot {
  id      String   @id @default(cuid())
  taskId  String
  task    Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  startAt DateTime
  endAt   DateTime
  allDay  Boolean  @default(false)

  @@index([taskId])
}
