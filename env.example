# Gabarit de la .env locale : `cp env.example .env` (la .env n'est jamais versionnée).
# Valeurs locales de développement ; les secrets de production vivent sur le serveur, posés par deploy/deploy.sh —
# ne jamais les mettre ici ni les donner à un agent.
DATABASE_URL="postgresql://pilote:pilote@localhost:5432/pilote_dev"
UPLOAD_DIR="./uploads"
# Mode démo : « Changer d'utilisateur » reste disponible aux personnes connectées.
PILOTE_DEMO=1
# Comptes (lot F) : en local un secret de circonstance est fourni par le code ; obligatoire en production (openssl rand -hex 32).
# BETTER_AUTH_SECRET=""
# BETTER_AUTH_URL="http://localhost:3001/api/auth"
# Sous-chemin de déploiement (vide en local) : NEXT_PUBLIC_BASE_PATH="/outilcli/cress/pilote"
# Mot de passe commun des comptes de démo au seed (défaut : pilote-demo-2026) : DEMO_PASSWORD=""
# Réalisé comptable (lot D), facultatif : PENNYLANE_API_TOKEN="" PENNYLANE_API_BASE="https://app.pennylane.com/api/external/v2"
# Tests : TEST_DATABASE_URL="postgresql://pilote:pilote@localhost:5432/pilote_test" PW_PORT=3100 (AUTH_RATE_LIMIT=0 est posé par playwright.config.ts)
