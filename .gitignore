# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-test/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# base de démo
prisma/prototype.db
prisma/prototype.db-journal
/test-results
/playwright-report

# .env reste hors dépôt (revue du 18/09) ; le gabarit versionné est env.example

# pièces jointes déposées dans le prototype
/uploads/*
!/uploads/.gitkeep
/.next-build
/.next-test
/.next-test*
/.next-test.corrompu*
/uploads-test/
/uploads-test-tlst/
/tests/.auth/

# artefacts régénérés par la suite sécurité (tests/security/global-setup.ts) : sessions, identifiants de fixtures, pièces déposées
/uploads-security/
/uploads-security-harness/
/tests/.security-auth/
/tests/.security-*
/.next-security/
/.next-restore/

# tout dossier de build Next (aperçus locaux compris)
/.next*/
# journaux de deploy.sh (check:full avant envoi)
/.deploy-logs/
