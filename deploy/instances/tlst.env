# Instance TLST sur bazixx-vps (convention outilcli). DNS tlst.bazixx.fr et certificat à poser à la main avant la première
# mise en ligne (deploy/nginx/tlst.bazixx.fr.conf). Aucun secret ici.
CLIENT=tlst
HOST=bazixx-vps
DIR=/var/www/tlst-pilote
DATA=/var/www/tlst-pilote-data
MEDIAS=/var/www/tlst-pilote-medias
BACKUP_DIR=/var/backups/tlst
DBNAME=tlst_pilote
DBUSER=tlst_pilote
PORT=3003
BASE_PATH=/outilcli/tlst/pilote
PUBLIC_URL=https://tlst.bazixx.fr/outilcli/tlst/pilote
SERVICE=pilote@tlst
LEGACY_SERVICE=
MAINTENANCE_FLAG=/var/www/maintenance/ACTIF-tlst
